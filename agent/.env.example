# Any OpenAI-compatible endpoint works. Free options (check current limits/model names):
#  Groq:        https://api.groq.com/openai/v1                          llama-3.3-70b-versatile
#  Gemini:      https://generativelanguage.googleapis.com/v1beta/openai/ gemini-2.5-flash
#  GitHub:      https://models.github.ai/inference                      openai/gpt-4.1-mini
#  OpenRouter:  https://openrouter.ai/api/v1                            (a ":free" model)
LLM_BASE_URL=https://api.groq.com/openai/v1
LLM_MODEL=llama-3.3-70b-versatile
LLM_API_KEY=

# Fine-grained PAT limited to THIS repo: Contents RW + Pull requests RW
GITHUB_TOKEN=
GITHUB_REPO=your-user/ai-sre-gitops

# Optional Slack incoming webhook
SLACK_WEBHOOK_URL=

# propose = may open PRs (human merges) | observe = never writes anything
AGENT_MODE=propose
